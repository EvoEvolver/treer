server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"service":"treer-app","status":"ok"}';
    }

    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"proxy_url":"${TREER_PROXY_PUBLIC_URL}"}';
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
