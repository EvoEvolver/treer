{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Treer Telegram plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["allowed_user_ids", "bindings"],
  "properties": {
    "api_base_url": { "type": "string", "format": "uri", "default": "https://api.telegram.org" },
    "allowed_user_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "type": "integer" }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chat_id", "target_agent_id"],
        "properties": {
          "chat_id": { "type": "integer" },
          "message_thread_id": { "type": ["integer", "null"] },
          "target_agent_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "wake_agent": { "type": "boolean", "default": false }
        }
      }
    },
    "poll_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 50, "default": 25 },
    "receive_wait_milliseconds": { "type": "integer", "minimum": 0, "maximum": 30000, "default": 10000 },
    "batch_size": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 },
    "retry_initial_seconds": { "type": "number", "minimum": 0.01, "maximum": 300, "default": 1 },
    "retry_max_seconds": { "type": "number", "minimum": 0.01, "maximum": 3600, "default": 60 },
    "ambiguous_retry_seconds": { "type": "number", "minimum": 0.01, "maximum": 3600, "default": 5 },
    "respond_to_denied": { "type": "boolean", "default": true }
  }
}
