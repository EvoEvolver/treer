{
  "name": "treer-agent-ui",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node tests/live.mjs",
    "test:claude": "tsx tests/live-claude.ts",
    "test:goal:live": "node tests/browser-goal-live.mjs",
    "test:claude:settings": "node tests/browser-claude-settings.mjs",
    "test:claude:settings:fake": "node tests/browser-claude-settings.mjs --fake",
    "test:browser": "node tests/browser.mjs",
    "test:windows": "node tests/windows-smoke.mjs",
    "build": "esbuild markdown.entry.js --bundle --format=esm --minify --legal-comments=inline --outfile=public/markdown.js",
    "check": "npm run typecheck && node --check public/app.js && node --check public/files.js && node --check public/theme.js && node --check public/markdown.js",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "tsx": "^4.19.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "dompurify": "3.4.14",
    "esbuild": "0.28.2",
    "marked": "18.0.10",
    "typescript": "^5.8.3"
  }
}
