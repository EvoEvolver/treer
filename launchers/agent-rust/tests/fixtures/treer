#!/usr/bin/env node
// Sealed experiment CLI: no network except the test's own loopback manifest.
import { writeFile, appendFile, readFile, access } from 'node:fs/promises';
import { localFetch } from '../../../agent/tests/hermetic.mjs';
const args = process.argv.slice(2);
if (args[0] === 'message' && ['receive','ack'].includes(args[1])) {
  if (!process.env.RUST_SPIKE_MESSAGE_INPUT) throw Error('message fixture not configured');
  if (args[1] === 'receive') {
    let deliveries=[];
    try {deliveries=JSON.parse(await readFile(process.env.RUST_SPIKE_MESSAGE_INPUT,'utf8'));}catch(error){if(error.code!=='ENOENT')throw error;}
    await new Promise((resolve,reject)=>process.stdout.write(JSON.stringify({deliveries})+'\n',error=>error?reject(error):resolve()));process.exit(0);
  }
  // Record the simulated remote ACK BEFORE an optional reply stall. Killing
  // the owned launcher here exercises remote-success/local-checkpoint loss.
  const journal=JSON.parse(await readFile(process.env.TREER_AGENT_PRIVATE_STATE_DIR+'/rust-spike.json','utf8'));
  const checkpoint=journal.records.flatMap(r=>r.source_messages??[]).find(m=>m.deliveryId===args[2]);
  if(!checkpoint)throw Error('ACK before durable admission');
  await appendFile(process.env.RUST_SPIKE_CLI_LOG,JSON.stringify({ack:args[2],operation:args[4],durable:true,ackPending:checkpoint.ackPending})+'\n',{mode:0o600});
  if(process.env.RUST_SPIKE_MESSAGE_ACK_GATE) {
    while(true){try{await access(process.env.RUST_SPIKE_MESSAGE_ACK_GATE);break;}catch{}await new Promise(r=>setTimeout(r,20));}
  }
  console.log('{}');process.exit(0);
}
if (args[0] === 'message' && args[1] === 'send') {
  let payload='';for await(const chunk of process.stdin)payload+=chunk;
  await appendFile(process.env.RUST_SPIKE_CLI_LOG,JSON.stringify({args,payload:JSON.parse(payload)})+'\n',{mode:0o600});
  if(process.env.RUST_SPIKE_NOTIFY_BLOCK==='1')await new Promise(resolve=>setTimeout(resolve,30000));
  console.log('{}');process.exit(0);
}
if (args[0] !== 'interface' || args[1] !== 'register') throw Error('unexpected fixture CLI command');
const port = args[args.indexOf('--port') + 1];
const response = await localFetch(`http://127.0.0.1:${port}/v1/manifest`);
if (response.status !== 200) throw Error('manifest unavailable during registration');
const manifest = await response.json();
if (manifest.instance_id !== process.env.AGENT_UI_INSTANCE_ID) throw Error('wrong instance');
await writeFile(process.env.RUST_SPIKE_CLI_LOG, JSON.stringify(manifest), {mode:0o600});
console.log('{}');
