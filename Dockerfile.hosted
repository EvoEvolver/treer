# Hosted deployments must carry verified native artifacts for all supported machines.
FROM rust:1-bookworm AS builder
ARG TREER_BUILD_COMMIT
ENV TREER_BUILD_COMMIT=$TREER_BUILD_COMMIT
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY launchers/agent/profiles.json ./launchers/agent/profiles.json
COPY skills ./skills
COPY scripts/install.ps1 ./scripts/install.ps1
COPY apps/policy/AGENT.md apps/policy/policy.py apps/policy/treer-policy ./apps/policy/
COPY apps/policy/web ./apps/policy/web
RUN cargo build --locked --release -p treer-proxy

FROM debian:bookworm-slim AS artifacts
ARG TREER_BUILD_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/verify-machine-artifacts.sh scripts/machine-artifact-hashes.sh /
COPY dist /dist
# No repository in this stage: reuse provenance is re-checked here for bytes and hashes only;
# its ancestry and path allowlist were verified against the repository by stage-hosted-proxy.sh.
RUN TREER_ARTIFACT_VERIFY_NO_GIT=1 sh /verify-machine-artifacts.sh "$TREER_BUILD_COMMIT" /dist

FROM debian:bookworm-slim
ARG TREER_BUILD_COMMIT
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/treer-proxy /usr/local/bin/treer-proxy
COPY --from=artifacts /dist /app/dist
LABEL org.opencontainers.image.source="https://github.com/EvoEvolver/treer"
LABEL org.opencontainers.image.revision="${TREER_BUILD_COMMIT}"
ENV TREER_ARTIFACTS_DIR=/app/dist
EXPOSE 8080
ENTRYPOINT ["treer-proxy"]
