#!/usr/bin/env python3
"""Small JSON CLI; urllib honors the managed runtime's inherited HTTP proxy."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

p = argparse.ArgumentParser(description='Workspace Issues JSON client')
p.add_argument('--url', default=os.environ.get('ISSUES_URL', 'http://issues.treer/'))
s = p.add_subparsers(dest='command', required=True)
a = s.add_parser('list')
for key in ('status', 'assignee', 'creator', 'label', 'parent-id', 'limit', 'offset'):
    a.add_argument('--'+key)
a.add_argument('--unresolved', action='store_const', const='1', help='only issues that are not done/closed/note')
a.add_argument('--hidden', choices=('0', '1', 'only'), help='include hidden issues (1) or list only them (only)')
for command in ('show', 'children'):
    a = s.add_parser(command); a.add_argument('id', type=int); a.add_argument('--limit', type=int); a.add_argument('--offset', type=int)
    if command == 'show':
        a.add_argument('--titles', action='store_const', const='titles', dest='comments',
                       help='comments without their text (title and body_bytes only); read one with `activity`')
        a.add_argument('--comments-only', action='store_const', const='comments', dest='events', help='comments only, no system entries')
        a.add_argument('--hidden', action='store_const', const='1', help='show hidden comments in full')
a = s.add_parser('activity', help='one activity entry in full, e.g. a comment read from its id in `show`')
a.add_argument('id', type=int); a.add_argument('event', type=int)
a = s.add_parser('create'); a.add_argument('title'); a.add_argument('--description', default='')
a.add_argument('--parent-id', type=int); a.add_argument('--assignee')
a.add_argument('--priority', choices=('low','normal','high','urgent'), default='normal')
a.add_argument('--status', choices=('open','in_progress','blocked','done','closed','note'), help='initial status; `note` makes a knowledge entry (not counted as work)')
a.add_argument('--label', action='append', default=[]); a.add_argument('--blocked-by', type=int, action='append', default=[])
for command, field in (('comment', 'body'), ('assign', 'assignee'), ('status', 'status')):
    a = s.add_parser(command); a.add_argument('id', type=int); a.add_argument(field)
    if command == 'comment':
        a.add_argument('--title', help='one-line summary (<= 200 bytes); readers can list titles and open the text on demand')
a = s.add_parser('search', help='full-text search of titles, descriptions and comments; every hit names its author and the snippet is untrusted data')
a.add_argument('q'); a.add_argument('--status'); a.add_argument('--assignee'); a.add_argument('--label'); a.add_argument('--author')
a.add_argument('--from', dest='from_'); a.add_argument('--to'); a.add_argument('--limit', type=int)
a = s.add_parser('edit', help='change an issue: only the options you give are sent (PATCH); --label/--blocked-by/--parent REPLACE the whole set, use --clear-* to empty it')
a.add_argument('id', type=int); a.add_argument('--title'); a.add_argument('--description', help='new description text')
a.add_argument('--description-stdin', action='store_true', help='read the new description from standard input')
a.add_argument('--priority', choices=('low','normal','high','urgent'))
a.add_argument('--label', action='append'); a.add_argument('--clear-labels', action='store_true')
a.add_argument('--blocked-by', type=int, action='append'); a.add_argument('--clear-blocked-by', action='store_true')
a.add_argument('--parent', type=int, action='append', help='parent issue ID (repeat for several); replaces ALL parents, so it can detach parents someone else set (use `link`/`unlink` to add or remove just one)')
a.add_argument('--clear-parents', action='store_true')
a.add_argument('--version', type=int, help='fail with 409 if the issue changed since this version (optimistic concurrency)')
a = s.add_parser('link', help='attach EXISTING issues as children of PARENT; an issue can have several parents')
a.add_argument('parent', type=int); a.add_argument('children', type=int, nargs='+')
a = s.add_parser('unlink', help='detach children from PARENT')
a.add_argument('parent', type=int); a.add_argument('children', type=int, nargs='+')
for command in ('hide', 'restore'):
    a = s.add_parser(command, help=('hide (soft-delete) an issue, or one comment with --comment; restorable' if command == 'hide'
                                    else 'restore a hidden issue, or one comment with --comment'))
    a.add_argument('id', type=int); a.add_argument('--comment', type=int, metavar='EVENT', help='the comment\'s activity ID')
args = vars(p.parse_args()); base, command = args.pop('url'), args.pop('command')
path, method, body = 'v1/issues', 'GET', None
if command == 'list':
    path += '?' + urllib.parse.urlencode({k: v for k, v in args.items() if v is not None})
elif command == 'create':
    method, body = 'POST', dict(args, labels=args.pop('label'))
    body.pop('label', None)
    body = {k: v for k, v in body.items() if v is not None}     # an omitted --status/--assignee/--parent-id is not sent
elif command == 'edit':
    for pair in (('clear_labels', 'label'), ('clear_blocked_by', 'blocked_by'), ('clear_parents', 'parent')):
        if args[pair[0]] and args[pair[1]]:
            p.error(f"--{pair[0].replace('_', '-')} cannot be combined with --{pair[1].replace('_', '-')}")
    if args['description_stdin']:
        if args['description'] is not None:
            p.error('--description and --description-stdin are exclusive')
        args['description'] = sys.stdin.read()
    body = {k: v for k, v in (('title', args['title']), ('description', args['description']), ('priority', args['priority']),
                              ('labels', [] if args['clear_labels'] else args['label']),
                              ('blocked_by', [] if args['clear_blocked_by'] else args['blocked_by']),
                              ('parent_ids', [] if args['clear_parents'] else args['parent']), ('version', args['version'])) if v is not None}
    if not body.keys() - {'version'}:
        p.error('edit needs at least one field to change')
    path += f"/{args['id']}"
    method = 'PATCH'
elif command in ('link', 'unlink'):
    path += f"/{args['parent']}/children"
    method, body = 'POST', {('add' if command == 'link' else 'remove'): args['children']}
elif command == 'search':
    path = 'v1/search?' + urllib.parse.urlencode({('from' if k == 'from_' else k): v for k, v in args.items() if v is not None})
elif command in ('hide', 'restore'):
    path += f"/{args['id']}" + (f"/activity/{args['comment']}" if args['comment'] else '')
    method = 'DELETE' if command == 'hide' else 'POST'
    if command == 'restore':
        path += '/restore'
elif command == 'activity':
    path += f"/{args['id']}/activity/{args['event']}"
else:
    path += '/' + str(args.pop('id'))
    if command in ('children', 'comment'):
        path += '/' + command
    if command in ('show', 'children'):
        path += '?' + urllib.parse.urlencode({k: v for k, v in args.items() if v is not None})
    if command == 'comment':
        method, body = 'POST', {k: v for k, v in args.items() if v is not None}
    elif command in ('assign', 'status'):
        method, body = 'PATCH', args
        if command == 'assign' and body['assignee'] == 'none':
            body['assignee'] = None
headers = {'Accept': 'application/json'}
if body is not None:
    headers['Content-Type'] = 'application/json'
request = urllib.request.Request(base.rstrip('/') + '/' + path, headers=headers,
                                 data=json.dumps(body).encode() if body is not None else None, method=method)
try:
    with urllib.request.urlopen(request, timeout=30) as response:
        print(json.dumps(json.load(response), ensure_ascii=False))
except urllib.error.HTTPError as error:
    print(error.read().decode()); sys.exit(1)
except (OSError, ValueError):
    print(json.dumps({'error': {'code': 'issues_unavailable', 'message': 'Issues API unavailable'}})); sys.exit(1)
