{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Treer Telegram App configuration (seeds the POC registry; the registry is authoritative afterwards)",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "api_base_url": {
      "type": "string",
      "format": "uri",
      "default": "https://api.telegram.org"
    },
    "allowed_user_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "integer"
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chat_id",
          "target_agent_id"
        ],
        "properties": {
          "chat_id": {
            "type": "integer"
          },
          "message_thread_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "target_agent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "wake_agent": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Initial POC bindings (chat/topic -> target Agent). Later changes live in the registry (/poc in the chat or Core control messages) and are never overwritten by this list."
    },
    "poll_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 25
    },
    "receive_wait_milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000,
      "default": 10000
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "retry_initial_seconds": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 300,
      "default": 1
    },
    "retry_max_seconds": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 3600,
      "default": 60
    },
    "ambiguous_retry_seconds": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 3600,
      "default": 5
    },
    "respond_to_denied": {
      "type": "boolean",
      "default": true
    },
    "users": {
      "type": "array",
      "maxItems": 1000,
      "description": "Admitted Telegram users with a label shown to the POC in external_source.metadata.user_label.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_user_per_hour": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 60
        },
        "per_conversation_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 20
        },
        "max_unreplied": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 50,
          "description": "Inbound messages per conversation since the POC last wrote to it."
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_admin_agent_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "description": "Restricts who may admit/disable IM users through control messages. Absent: any sender the bridge accepts (default). A list: only these Agent IDs. An empty list: nobody. POC changes are never restricted by this."
        }
      }
    },
    "bot_token_file": {
      "type": "string",
      "description": "Absolute path of a private (0600, owned by the bridge's user, not a symlink) file holding the bot token. Used when TELEGRAM_BOT_TOKEN is not set; keeps the token out of argv, the environment and this configuration."
    }
  },
  "anyOf": [
    {
      "required": [
        "allowed_user_ids"
      ]
    },
    {
      "required": [
        "users"
      ]
    }
  ]
}
