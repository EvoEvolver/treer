#!/usr/bin/env python3
"""JSON client for delegated Policy edits through the Managed App proxy."""
import argparse
import json
import os
import sys
import stat
from pathlib import Path
import urllib.error
import urllib.parse
import urllib.request

MAX_BYTES = 300 * 1024


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, fp, code, message, headers, newurl):
        return None


def read_config(path):
    path = Path(os.path.abspath(os.path.expanduser(path)))
    for component in (path, *path.parents):
        if component.is_symlink():
            raise ValueError('Config symlinks are not allowed')
    parent = path.parent.stat()
    if parent.st_uid != os.geteuid() or stat.S_IMODE(parent.st_mode) != 0o700:
        raise ValueError('Config directory must be private')
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.geteuid() or stat.S_IMODE(metadata.st_mode) != 0o600:
            raise ValueError('Config must be a private regular file')
        with os.fdopen(descriptor, 'rb', closefd=False) as stream:
            raw = stream.read(16385)
        if len(raw) > 16384:
            raise ValueError('Config too large')
        config = json.loads(raw)
        token = config.get('token') if isinstance(config, dict) else None
        if not isinstance(token, str) or not 32 <= len(token) <= 8192 or any(ord(c) < 33 or ord(c) > 126 for c in token):
            raise ValueError('Invalid token')
        return config
    finally:
        os.close(descriptor)


def sanitized(value, token):
    if isinstance(value, str):
        return value.replace(token, '[redacted]')
    if isinstance(value, dict):
        return {sanitized(k, token): sanitized(v, token) for k, v in value.items()}
    if isinstance(value, list):
        return [sanitized(v, token) for v in value]
    return value


def main():
    parser = argparse.ArgumentParser(description='Read, publish or explain Policy using your private operator configuration.')
    parser.add_argument('--config', default=os.environ.get('POLICY_CLIENT_CONFIG', '~/.config/treer-policy/config.json'))
    commands = parser.add_subparsers(dest='command', required=True)
    commands.add_parser('read')
    for name in ('submit', 'preview'):
        command = commands.add_parser(name)
        command.add_argument('request', help='Core-contract JSON request file, or - for stdin')
    args = parser.parse_args()
    try:
        config = read_config(args.config)
        token = config['token']
        url = config.get('url', 'http://policy.treer/')
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment:
            raise ValueError('Invalid App URL')
        data = None
        if args.command != 'read':
            if args.request == '-':
                raw = sys.stdin.buffer.read(MAX_BYTES + 1)
            else:
                with open(args.request, 'rb') as stream:
                    raw = stream.read(MAX_BYTES + 1)
            if len(raw) > MAX_BYTES:
                raise ValueError('Request exceeds size limit')
            body = json.loads(raw)
            if not isinstance(body, dict):
                raise ValueError('Request must be a JSON object')
            data = json.dumps(body).encode()
        path = {'read':'v1/state', 'submit':'v1/policy/publish', 'preview':'v1/policy/explain'}[args.command]
        request = urllib.request.Request(url.rstrip('/') + '/' + path, data=data,
            headers={'Accept':'application/json', 'Content-Type':'application/json', 'Authorization':'Bearer ' + token},
            method='GET' if args.command == 'read' else 'POST')
        # Preserve the runtime HTTP proxy: it injects the caller's own service
        # identity for this App. The operator token comes only from the private
        # file; never copy workload credentials into headers.
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=30) as response:
            result = json.loads(response.read(2 * 1024 * 1024))
        print(json.dumps(sanitized(result, token), ensure_ascii=False))
        return 0
    except urllib.error.HTTPError as error:
        try:
            code = json.loads(error.read(65536))['error']['code']
            if not isinstance(code, str) or len(code) > 128:
                code = 'policy_request_rejected'
            code = sanitized(code, token)
        except (ValueError, KeyError, TypeError):
            code = 'policy_request_rejected'
        print(json.dumps({'error':{'code':code,'message':'Policy App rejected the request'},'status':error.code}))
    except (OSError, ValueError, TypeError):
        print(json.dumps({'error':{'code':'policy_request_failed','message':'Invalid input or Policy App unavailable'}}))
    return 1


if __name__ == '__main__':
    sys.exit(main())
